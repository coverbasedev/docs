              {
                "group": "API Reference",
                "icon": "code",
                "pages": [
                  "integrations/api-reference/api-keys",
                  "integrations/api-reference/vendors",
                  "integrations/api-reference/users",
                  "integrations/api-reference/assessments",
                  "integrations/api-reference/findings",
                  "integrations/api-reference/obligations",
                  "integrations/api-reference/workflows",
                  "integrations/api-reference/webhooks"
