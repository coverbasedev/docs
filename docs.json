            "pages": [
              "export-api-concepts",
              "export",
              "import-api",
              "import"
            ]
          },
          {
            "group": "Integration Workflows",
            "icon": "diagram-project",
            "pages": [
              "integrations/overview",
              "integrations/workflow-engine",
              "integrations/triggering-workflows",
