              "mcp/connecting",
              "mcp/example-prompts",
              "mcp/security",
              "mcp/troubleshooting"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Content Library",
          "href": "https://www.coverbase.com/content-library",
          "icon": "newspaper",
          "color": {
            "light": "#000000",
            "dark": "#000000"
          }
        }
      ]
    }
