    "links": [
      {
        "label": "Support",
        "href": "mailto:support@coverbase.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.coverbase.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/coverbase"
    }
  },
  "description": "The Coverbase API is the programmatic surface for the Coverbase third-party risk and procurement platform. It lets you move vendor, assessment, and risk data between Coverbase and the systems your team already runs, and lets AI assistants act on your TPRM program through natural conversation.",
  "appearance": {
    "strict": true
  },
  "seo": {
    "metatags": {
      "llms-txt": "https://docs.coverbase.com/llms.txt"
    }
